  m_Script: {fileID: 11500000, guid: fd7f2da03b4b4f579a23fbec71d1779a, type: 3}
  m_Name: G04_Lunar_surface_stay_no_stay_decision
  m_EditorClassIdentifier:
  missionId: "G-04"
  title: "Lunar surface stay / no-stay decision"
  timeWindowLabel: "5:45–6:50"
  availableFromSeconds: 345
  availableUntilSeconds: 410
  durationSeconds: 60
  difficulty: "Medium"
  briefing: "Review the descent-stage propellant pressure warning, run the available venting and avionics safety checks, and decide whether conditions permit the crew to remain on the surface or require an early departure. The decision and checks are available to every role."
  originalDiscipline: "G"
  globalEvent: 1
  objectiveType: 2
  locationName: "Bridge"
  deck: 2
  shipPixelX: 420
  interactionRadius: 1.6
  targetDeck: 0
  targetShipPixelX: 1030
  radiationIncreaseOnSkip: 0
  radiationIncreaseOnExpiry: 0
  damageOnFailure: 10
  failureIsFatalAtHighRadiation: 0
  fatalRadiationThreshold: 60
  allowedRoles: []
  steps:
  - prompt: "Descent-stage propellant pressure WARNING. Review the surface-stay request."
    options:
    - "Continue surface operations without checking"
    - "Ignore the pressure warning"
    - "Hold the stay decision and run safety checks"
    correctChoice: 2
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Propellant venting verification is available."
    options:
    - "Vent toward crew and equipment"
    - "Run controlled venting and check pressure response"
    - "Block the vent path"
    correctChoice: 1
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Avionics safety verification in progress."
    options: []
    correctChoice: 0
    automatic: 1
    requiresShelter: 0
    durationSeconds: 25
    result: "Verification complete."
  - prompt: "Venting complete, but pressure remains OUTSIDE SAFE BAND. Avionics isolation is ready."
    options:
    - "STAY: ignore the persistent unsafe pressure"
    - "Begin an unrelated launchpad check"
    - "NO-STAY: isolate the hazard and prepare early departure"
    correctChoice: 2
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
