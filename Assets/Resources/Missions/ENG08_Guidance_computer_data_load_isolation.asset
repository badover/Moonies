  missionId: "ENG-08"
  title: "Guidance-computer data-load isolation"
  timeWindowLabel: "4:55–5:45"
  availableFromSeconds: 295
  availableUntilSeconds: 345
  durationSeconds: 60
  difficulty: "Medium"
  briefing: "Inspect the computer-load display during the 1202 alarm, identify the non-essential radar or science-data streams contributing to the overload, isolate those streams, and verify that processor load returns to the safe range while core guidance remains active. This is an engineering systems task, independent of the Commander's operational decision."
  originalDiscipline: "ENG"
  globalEvent: 0
  objectiveType: 2
  locationName: "Engineering"
  deck: 0
  shipPixelX: 750
  interactionRadius: 1.6
  targetDeck: 0
  targetShipPixelX: 1030
  radiationIncreaseOnSkip: 0
  radiationIncreaseOnExpiry: 0
  damageOnFailure: 10
  failureIsFatalAtHighRadiation: 0
  fatalRadiationThreshold: 60
  allowedRoles: []
  steps:
  - prompt: "1202 alarm: processor overloaded. Core landing guidance remains functional."
    options:
    - "Increase every radar data rate"
    - "Inspect data-stream load while preserving guidance"
    - "Shut down core landing guidance"
    correctChoice: 1
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Non-essential radar and science streams are saturating the input queue."
    options:
    - "Isolate the non-essential data streams"
    - "Disconnect the essential guidance channel"
    - "Keep all redundant streams at maximum load"
    correctChoice: 0
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Processor-load verification."
    options: []
    correctChoice: 0
    automatic: 1
    requiresShelter: 0
    durationSeconds: 24
    result: "Verification complete."
  - prompt: "Processor load safe; core guidance ACTIVE."
    options:
    - "Disable the recovered guidance computer"
    - "Confirm data-load isolation"
    - "Resume all overload-producing streams"
    correctChoice: 1
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
