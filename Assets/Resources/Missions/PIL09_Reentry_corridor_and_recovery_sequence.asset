  m_Name: PIL09_Reentry_corridor_and_recovery_sequence
  m_EditorClassIdentifier:
  missionId: "PIL-09"
  title: "Re-entry and recovery"
  timeWindowLabel: "9:00–10:00"
  availableFromSeconds: 540
  availableUntilSeconds: 600
  durationSeconds: 90
  difficulty: "Hard"
  briefing: "Stay within the marked re-entry path. Deploy the main parachutes at the cue, then right the capsule before opening the hatch."
  stationId: bridge
  originalDiscipline: "PIL"
  globalEvent: 0
  objectiveType: 2
  locationName: "Bridge"
  deck: 2
  shipPixelX: 420
  interactionRadius: 1.6
  targetDeck: 0
  targetShipPixelX: 1030
  radiationIncreaseOnSkip: 0
  radiationIncreaseOnExpiry: 0
  damageOnFailure: 25
  failureIsFatalAtHighRadiation: 0
  fatalRadiationThreshold: 60
  allowedRoles: []
  steps:
  - prompt: "Use the marked correction to stay on the re-entry path."
    options:
    - "Leave the path high"
    - "Stay on the marked path"
    - "Leave the path low"
    correctChoice: 1
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Re-entry path maintained."
  - prompt: "The parachute cue has not appeared. Keep monitoring."
    options:
    - "Wait for the deployment cue"
    - "Deploy during peak heating"
    - "Turn off entry checks"
    correctChoice: 0
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Entry monitored."
  - prompt: "The deployment cue is on. Deploy the main parachutes."
    options:
    - "Cut the parachutes"
    - "Wait past the cue"
    - "Deploy the parachutes"
    correctChoice: 2
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Main parachutes deployed."
  - prompt: "Checking splashdown and capsule position..."
    options: []
    correctChoice: 0
    automatic: 1
    requiresShelter: 0
    durationSeconds: 30
    result: "Recovery check complete."
  - prompt: "The capsule is upside down. Use the righting system before exit."
    options:
    - "Use righting system and confirm upright"
    - "Open the hatch now"
    - "Turn off righting system"
    correctChoice: 0
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Capsule righted for recovery."
