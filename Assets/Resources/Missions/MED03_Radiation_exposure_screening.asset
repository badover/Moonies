  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd7f2da03b4b4f579a23fbec71d1779a, type: 3}
  m_Name: MED03_Radiation_exposure_screening
  m_EditorClassIdentifier:
  missionId: "MED-03"
  title: "Radiation exposure screening"
  timeWindowLabel: "2:15–3:50"
  availableFromSeconds: 135
  availableUntilSeconds: 230
  durationSeconds: 60
  difficulty: "Medium"
  briefing: "Compare radiation-counter readings with crew exposure indicators, identify the highest-risk exposure status, and record the appropriate observation priority. The Medic does not need to operate the spacecraft's power or attitude systems."
  originalDiscipline: "MED"
  globalEvent: 0
  objectiveType: 2
  locationName: "Medical Bay"
  deck: 1
  shipPixelX: 1840
  interactionRadius: 1.6
  targetDeck: 0
  targetShipPixelX: 1030
  radiationIncreaseOnSkip: 0
  radiationIncreaseOnExpiry: 0
  damageOnFailure: 10
  failureIsFatalAtHighRadiation: 0
  fatalRadiationThreshold: 60
  allowedRoles: []
  steps:
  - prompt: "Exposure counters: crew A low, crew B elevated, crew C highest and rising."
    options:
    - "Ignore exposure counters"
    - "Prioritize crew C for close observation"
    - "Prioritize only the lowest counter"
    correctChoice: 1
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Compare counter trends with the recorded crew exposure indicators."
    options:
    - "Record the highest-risk exposure status"
    - "Reset the counters to hide the event"
    - "Wait for another role before recording"
    correctChoice: 0
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Exposure-screening record verification."
    options: []
    correctChoice: 0
    automatic: 1
    requiresShelter: 0
    durationSeconds: 24
    result: "Verification complete."
  - prompt: "Highest-risk crew member flagged; no clinical diagnosis is implied."
    options:
    - "Clear all crew without follow-up"
    - "Confirm observation priority"
    - "Prescribe a procedure from this screen"
    correctChoice: 1
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
