  steps:
  - prompt: "Lunar far-side pass will interrupt the Earth link; LOI plan is preloaded."
    options:
    - "Require live Earth commands throughout blackout"
    - "Cancel because loss of signal is expected"
    - "Review the planned blackout and autonomous burn plan"
    correctChoice: 2
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Loaded parameters: retrograde LOI, verified timing and cutoff."
