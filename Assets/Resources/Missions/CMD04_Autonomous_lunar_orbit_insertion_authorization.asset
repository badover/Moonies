  - prompt: "Parameters and autonomous guidance ready before blackout."
    options:
    - "Authorize with an unverified plan"
    - "Disable autonomous execution"
    - "Authorize autonomous lunar-orbit insertion"
    correctChoice: 2
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
