  steps:
  - prompt: "RTG fuel rod is thermally bound in its deployment cask."
    options:
    - "Grab the rod with bare hands"
    - "Use a short uninsulated tool"
    - "Inspect the binding and select an insulated long-handled tool"
    correctChoice: 2
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Release the thermally bound rod."
    options:
    - "Pull against the binding without inspection"
    - "Gently rock and rotate using the insulated tool"
    - "Strike the rod forcefully"
    correctChoice: 1
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Rod released. Complete the generator connection."
    options:
    - "Insert and secure the fuel rod in the RTG"
    - "Leave the hot rod loose beside the lander"
    - "Store it in the crew compartment"
    correctChoice: 0
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "RTG output and deployment verification."
    options: []
    correctChoice: 0
    automatic: 1
    requiresShelter: 0
    durationSeconds: 40
    result: "Verification complete."
  - prompt: "Generator output nominal. Select science-station placement."
    options:
    - "Aim exhaust and equipment at the lander"
    - "Position the station at the marked safe distance from the lander"
    - "Place the RTG beside the crew hatch"
    correctChoice: 1
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
