    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Adapter parts inspected."
  - prompt: "Choose how to connect the filter."
    options:
    - "Make a sealed bag-and-hose adapter"
    - "Leave a gap around the outlet"
