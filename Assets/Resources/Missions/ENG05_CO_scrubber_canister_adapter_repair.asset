    options: []
    correctChoice: 0
    automatic: 1
    requiresShelter: 0
    durationSeconds: 40
    result: "Airflow check complete."
  - prompt: "Airflow is back and CO₂ is falling. Confirm the repair."
    options:
    - "Confirm and keep monitoring"
    - "Claim success without airflow"
    - "Disconnect the working adapter"
    correctChoice: 0
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
