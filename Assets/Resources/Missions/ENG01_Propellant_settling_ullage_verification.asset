  m_Script: {fileID: 11500000, guid: fd7f2da03b4b4f579a23fbec71d1779a, type: 3}
  m_Name: ENG01_Propellant_settling_ullage_verification
  m_EditorClassIdentifier:
  missionId: "ENG-01"
  title: "Propellant settling / ullage verification"
  timeWindowLabel: "0:05–1:20"
  availableFromSeconds: 5
  availableUntilSeconds: 80
  durationSeconds: 30
  difficulty: "Easy"
  briefing: "Inspect the propellant-settling indicators, verify that the ullage sequence is required, activate the settling sequence, and confirm that liquid propellant is positioned correctly before the main engine burn. Do not authorize ignition while the propellant is unsettled."
  stationId: engineering
  originalDiscipline: "ENG"
  globalEvent: 0
  objectiveType: 2
  locationName: "Engineering"
  deck: 0
  shipPixelX: 750
  interactionRadius: 1.6
  targetDeck: 0
  targetShipPixelX: 1030
  radiationIncreaseOnSkip: 0
  radiationIncreaseOnExpiry: 0
  damageOnFailure: 5
  failureIsFatalAtHighRadiation: 0
  fatalRadiationThreshold: 60
  allowedRoles: []
  steps:
  - prompt: "Propellant state: UNSETTLED. Main engine burn is pending."
    options:
    - "Ignite the main engine immediately"
    - "Disable settling thrusters"
    - "Hold ignition and enable the ullage sequence"
    correctChoice: 2
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
  - prompt: "Settling thrusters responding. Liquid propellant is moving toward the feed inlet."
    options: []
    correctChoice: 0
    automatic: 1
    requiresShelter: 0
    durationSeconds: 16
    result: "Verification complete."
  - prompt: "Feed inlet: LIQUID. Settling: VERIFIED."
    options:
    - "Confirm propellant positioned for the burn"
    - "Authorize ignition with gas at the inlet"
    - "Cancel the successful settling sequence"
    correctChoice: 0
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Command accepted. Safe configuration verified."
