  steps:
  - prompt: "Propellant is unsettled. Hold ignition and start settling."
    options:
    - "Ignite now"
    - "Turn off settling thrusters"
    - "Hold ignition; start settling"
    correctChoice: 2
    automatic: 0
    requiresShelter: 0
    durationSeconds: 0
    result: "Ignition held; settling started."
  - prompt: "Settling is running. Waiting for liquid propellant to reach the feed..."
    options: []
    correctChoice: 0
    automatic: 1
    requiresShelter: 0
    durationSeconds: 16
