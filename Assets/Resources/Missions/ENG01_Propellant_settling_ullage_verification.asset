  missionId: "ENG-01"
  title: "Settle propellant before the engine burn"
  timeWindowLabel: "0:05–1:20"
  availableFromSeconds: 5
  availableUntilSeconds: 80
  durationSeconds: 30
  difficulty: "Easy"
  briefing: "Check the propellant indicators, start ullage settling, then confirm liquid propellant is at the engine feed. Keep ignition locked until then."
